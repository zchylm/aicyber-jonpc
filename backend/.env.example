#JON_PC_DB_URL=jdbc:postgresql://localhost:5432/jonpc
JON_PC_DB_URL=jdbc:postgresql://jonpc-db.postgres.database.azure.com:5432/jonpc?sslmode=require
JON_PC_DB_USERNAME=jonpc_admin
JON_PC_DB_PASSWORD=
JON_PC_DB_POOL_SIZE=5
JON_PC_FLYWAY_ENABLED=true
JON_PC_JWT_SECRET=replace-with-a-long-random-secret
JON_PC_JWT_EXPIRATION_HOURS=24
JON_PC_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
JON_PC_CLAUDE_MODEL=claude-sonnet-5

# Transactional email (Resend)
JON_PC_EMAIL_PROVIDER=resend
JON_PC_EMAIL_DISPATCH_ENABLED=true
JON_PC_EMAIL_FROM="JON. PC <support@jonpc.com.au>"
JON_PC_ORDERS_EMAIL_FROM="JON. PC Orders <orders@jonpc.com.au>"
JON_PC_EMAIL_REPLY_TO=support@jonpc.com.au
JON_PC_SUPPORT_EMAIL=support@jonpc.com.au
JON_PC_EMAIL_ACCOUNT_URL=https://jonpc.com.au/
JON_PC_EMAIL_OPERATIONS_RECIPIENT=support@jonpc.com.au
JON_PC_RESEND_API_KEY=
JON_PC_RESEND_WEBHOOK_SECRET=
JON_PC_EMAIL_VERIFICATION_ENABLED=true
JON_PC_PASSWORD_RESET_ENABLED=true
JON_PC_INVOICE_EMAIL=support@jonpc.com.au
JON_PC_INVOICE_EMAIL_DELIVERY_ENABLED=false
